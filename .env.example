# Canonical site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://tayoservices.ca

# Click-to-call number shown on the site (defaults to (236) 707-9582)
NEXT_PUBLIC_PHONE=(236) 707-9582

# Public contact email shown on the site
NEXT_PUBLIC_EMAIL=zakariemahamed9@gmail.com

# Optional analytics / Search Console
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional social / Google Business (used in reviews CTA + JSON-LD sameAs)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# Optional custom map iframe src (GBP pin or service-radius map)
NEXT_PUBLIC_MAP_EMBED_URL=

# --- Quote form email delivery (Resend) ---
# See docs/RESEND_DNS.md for tayoservices.ca DNS (DKIM + send/rsend CNAMEs).
# After the domain is Verified in Resend:
RESEND_API_KEY=
RESEND_FROM=Tayo Website <leads@tayoservices.ca>
LEADS_TO_EMAIL=zakariemahamed9@gmail.com

# Until DNS verifies, you can temporarily use:
# RESEND_FROM=Tayo Website <onboarding@resend.dev>
# (only delivers to the email you used to sign up for Resend)

# --- Quo (texting) — optional, never commit the real key ---
# Texts each new lead a confirmation and sends you a lead alert by SMS.
QUO_API_KEY=
# Quo number the texts come from (defaults to the site phone number)
QUO_FROM_NUMBER=+12367079582
# Your personal cell for instant lead alerts, e.g. +16045551234 (leave blank to skip)
QUO_ALERT_TO=
