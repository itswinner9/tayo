# Canonical site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://tayoservices.ca

# Required before launch — real click-to-call number, e.g. (604) 555-1234
NEXT_PUBLIC_PHONE=

# Public contact + lead fallback inbox
NEXT_PUBLIC_EMAIL=hello@tayoservices.ca

# Optional analytics / Search Console
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional social / Google Business (used in reviews CTA + JSON-LD sameAs)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# Optional custom map iframe src (GBP pin or service-radius map)
NEXT_PUBLIC_MAP_EMBED_URL=

# Lead email via Resend (required in production for /api/leads)
RESEND_API_KEY=
# Use a verified domain sender in production, e.g. Tayo Website <leads@tayoservices.ca>
RESEND_FROM=Tayo Website <leads@tayoservices.ca>
LEADS_TO_EMAIL=hello@tayoservices.ca
